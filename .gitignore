# Dependencies
node_modules/
/.pnp
.pnp.js

# Next.js
/.next/
/.next.old/
/out/

# Production build
/build

# Env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel
.vercel

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# TypeScript build cache
*.tsbuildinfo

# AI search — generated artefacts (large, contain API cost data, re-generatable)
data/ai-search/extracted.json
data/ai-search/baseline.json
data/ai-search/cost-log.json

# Scrape runtime cache — multi-MB JSON snapshot of the latest scrape
# run, consumed by ingest-scraped.ts. NOT bundled into the app
# (the server-imported src/lib/data/deals.ts is now a small
# hand-curated seed, ~12KB). Re-generate with `npm run scrape`.
scripts/data-cache/

# Generated marketing artefacts (price-gap social cards + manifest).
# Re-generate with scripts/generate-price-gap-cards.ts.
scripts/output/

# Remotion render output (large, regenerable MP4s; re-render any time
# from the remotion/src compositions). The composition SOURCE is the
# committed artifact. The rendered videos that ship now live in Supabase
# Storage (site-media bucket, served via CDN) — NOT in the repo. Both the
# scratch output dir and the final renders dir stay untracked so 80 MB+
# of regenerable binaries don't bloat the repo.
remotion/out/
remotion/renders/

# Strategy / planning docs generated locally — kept out of the repo so
# they can be regenerated freely without polluting commits.
docs/*.docx
